{
  "name": "sqlpackage-gui",
  "version": "1.9.0",
  "description": "Cross-Platform MSSQL BACPAC Export Desktop App",
  "main": "dist-electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Uzair42/mssqlDBTransferSqlPackage-gui_.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:linux": "tsc && vite build && electron-builder --linux AppImage deb",
    "build:win": "tsc && vite build && electron-builder --win nsis portable",
    "build:all": "tsc && vite build && electron-builder -lw",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.sqlpackage.gui",
    "productName": "MSSQL Database Migrator",
    "publish": [
      {
        "provider": "github",
        "owner": "Uzair42",
        "repo": "mssqlDBTransferSqlPackage-gui_"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "Uzair"
    },
    "win": {
      "target": [
        "zip",
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tar": "^7.4.3",
    "tedious": "^20.0.0"
  },
  "optionalDependencies": {
    "msnodesqlv8": "^4.2.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/tar": "^6.1.13",
    "@types/tedious": "^4.0.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
